Screen {
    layout: vertical;
}

#body {
    height: 1fr;
    layout: horizontal;
}

#main-pane {
    width: 1fr;
    layout: vertical;
}

#sidebar {
    width: 42;
    max-width: 42;
}

#output {
    height: 1fr;
    padding: 1;
    overflow-x: hidden;
    overflow-y: auto;
}

TabPane > ScrollableContainer {
    overflow-x: hidden;
    overflow-y: auto;
}

#tabs {
    height: 1fr;
    margin-bottom: 1;
}

#tabs > ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

TabbedContent Tabs {
    display: none;
}

#footer {
    height: 1;
    margin: 0 2 0 2;
}

#spinner {
    width: 3;
    display: none;
    margin-right: 1;
}

#footer-usage {
    color: $text-muted;
    text-style: dim;
    width: 1fr;
    min-width: 0;
    content-align: right middle;
    margin-right: 2;
    overflow: hidden;
}

#shortcuts {
    color: $text-muted;
    text-style: dim;
    width: auto;
    min-width: 0;
    content-align: right middle;
    margin-left: 0;
    overflow: hidden;
}

UserMessageWidget {
    background: $panel;
    margin: 0 1 0 0;
    padding: 1;
    border-left: thick $primary;
}

UserMessageWidget > MarkdownParagraph {
    margin: 0;
}

AssistantMessageWidget {
    margin: 0 1;
    padding: 1 1 0 1;
}

/* Switch markdown blocks from bottom-margin to top-margin spacing so the last
   block's margin doesn't stack with the chain-footer's margin-top. */
AssistantMessageWidget > MarkdownBlock {
    margin-bottom: 0;
}

AssistantMessageWidget > MarkdownBlock:first-child {
    margin-top: 0;
}

AssistantMessageWidget > MarkdownParagraph {
    margin-top: 1;
}

ThinkingMessageWidget {
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
}

/* Collapse widgets: override Textual defaults to match Rich.Panel style */
Collapsible.thinking-collapse {
    background: transparent;
    height: auto;
    margin: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top: none;
}

Collapsible.thinking-collapse.-collapsed {
    height: 1;
    margin: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top: none;
}

Collapsible.thinking-collapse.-collapsed > Contents {
    display: none;
    height: 0;
    margin: 0;
    padding: 0;
}

Collapsible.thinking-collapse > CollapsibleTitle {
    color: orange;
    width: 1fr;
}

Collapsible.thinking-collapse > Contents {
    height: auto;
    padding: 0 2;
}

.thinking-content {
    text-style: dim;
}

Collapsible.tool-result-collapse {
    background: transparent;
    height: auto;
    margin: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border: none;
}

ToolResultMessageWidget.after-thinking {
    margin-top: 1;
}

Collapsible.tool-result-collapse > Contents {
    height: auto;
    margin: 0 1;
    padding: 0 2;
}

Collapsible.tool-result-collapse.-collapsed {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border: none;
}

Collapsible.tool-result-collapse > CollapsibleTitle {
    color: skyblue;
    text-style: dim;
    width: 1fr;
}

#input-wrapper {
    background: $surface;
    margin: 1 2 0 2;
    padding: 0;
    height: auto;
    border-left: thick $surface;
}

#input-wrapper.-focused {
    border-left: thick $primary;
}

#input {
    width: 1fr;
    background: $surface;
    border: none;
    padding: 1 2 0 2;
    margin: 0;
    height: auto;
}

#input-meta {
    width: 1fr;
    height: auto;
    background: $surface;
    padding: 0 2 1 2;
    color: $text;
    text-style: none;
    margin: 0;
}

#command-picker {
    height: auto;
    max-height: 10;
    background: $surface;
    border: tall $primary;
    margin: 0 1;
}

#command-picker > .option-list--option-highlighted {
    background: $accent-darken-1;
}

OptionPicker {
    align: center middle;
}

#picker-container {
    width: 70;
    max-height: 80%;
    background: $surface;
    border: tall $primary;
    padding: 1;
}

#picker-header {
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
    margin-bottom: 1;
    border-bottom: solid $primary;
    width: 100%;
}

#picker-search {
    margin-bottom: 1;
}

#picker-list {
    height: 1fr;
}

.temp-tool-message {
    padding: 0 1;
    color: $text-muted;
    text-style: italic;
}

Button.settings-add-btn {
    content-align: center middle;
    text-align: center;
}
