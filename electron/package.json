{
  "name": "orchid-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Orchid — AI-powered desktop coding assistant",
  "author": {
    "name": "Orchid Contributors",
    "email": "orchid@example.com"
  },
  "homepage": "https://github.com/Zeptiny/orchid",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "predev": "npm run native:ensure:electron",
    "dev": "tsc -p tsconfig.node.json && npm run copy:defaults && npm run build:preload && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.node.json && npm run copy:defaults && npm run build:preload && vite build",
    "build:main": "tsc -p tsconfig.node.json && npm run copy:defaults",
    "copy:defaults": "node scripts/copy-defaults.js",
    "build:preload": "node scripts/build-preload.js",
    "build:renderer": "vite build",
    "catalog:seed": "node --experimental-strip-types scripts/provider-catalog/seed-models-dev.ts",
    "catalog:validate": "node --experimental-strip-types scripts/provider-catalog/validate.ts",
    "catalog:sign": "node --experimental-strip-types scripts/provider-catalog/sign.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:migration": "tsc --noEmit -p tsconfig.migration.json",
    "lint": "eslint src/",
    "check:runtime-cycles": "node scripts/check-runtime-cycles.mjs",
    "pretest": "npm run native:ensure:node",
    "test": "vitest run",
    "pretest:providers:live": "npm run native:ensure:node",
    "test:providers:live": "node --experimental-strip-types tests/smoke/provider-live.ts",
    "native:ensure:electron": "node scripts/ensure-native-runtime.mjs electron",
    "native:ensure:node": "node scripts/ensure-native-runtime.mjs node",
    "rebuild:native": "node scripts/ensure-native-runtime.mjs electron --force",
    "package": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml",
    "package:mac": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --mac",
    "package:win": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --win",
    "package:linux": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --linux",
    "package:all": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --mac --win --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.23",
    "@ai-sdk/google": "^4.0.26",
    "@ai-sdk/openai": "^4.0.22",
    "@ai-sdk/openai-compatible": "^3.0.16",
    "@ai-sdk/provider": "^4.0.4",
    "@ai-sdk/xai": "^4.0.20",
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ai": "^7.0.40",
    "better-sqlite3": "^13.0.1",
    "decimal.js": "^10.6.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.3.0",
    "node-pty": "^1.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shell-quote": "^1.10.0",
    "turndown": "^7.2.4",
    "web-tree-sitter": "^0.26.11",
    "xstate": "^5.32.5",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-feather": "^2.0.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.1.0"
  }
}
