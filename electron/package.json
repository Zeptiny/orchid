{
  "name": "orchid-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Orchid — AI-powered desktop coding assistant",
  "author": {
    "name": "Orchid Contributors",
    "email": "orchid@example.com"
  },
  "homepage": "https://github.com/Zeptiny/orchid",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.node.json && npm run copy:defaults && npm run build:preload && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.node.json && npm run copy:defaults && npm run build:preload && vite build",
    "build:main": "tsc -p tsconfig.node.json && npm run copy:defaults",
    "copy:defaults": "node -e \"const fs=require('fs');const path=require('path');const pairs=[['src/main/agents/defaults','dist/main/agents/defaults'],['src/main/skills/defaults','dist/main/skills/defaults'],['src/main/personality/defaults','dist/main/personality/defaults']];for(const [src,dst] of pairs){if(!fs.existsSync(src))continue;fs.mkdirSync(path.dirname(dst),{recursive:true});fs.cpSync(src,dst,{recursive:true});}\"",
    "build:preload": "node scripts/build-preload.js",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "rebuild:native": "./scripts/rebuild-native.sh",
    "package": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml",
    "package:mac": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --mac",
    "package:win": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --win",
    "package:linux": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --linux",
    "package:all": "npm run build && npm run rebuild:native && electron-builder --config electron-builder.yml --mac --win --linux"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@ai-sdk/provider": "^4.0.0",
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ai": "^7.0.0",
    "electron-updater": "^6.3.0",
    "node-pty": "^1.0.0",
    "shell-quote": "^1.9.0",
    "tree-sitter-wasms": "^0.1.4",
    "turndown": "^7.2.4",
    "web-tree-sitter": "^0.26.0",
    "xstate": "^5.18.0",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.0.0",
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@eslint/js": "^10.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/shell-quote": "^1.7.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.0",
    "daisyui": "^5.6.16",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-feather": "^2.0.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.0"
  }
}
