{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "jsx": "preserve"
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*"]
}
